+#[test]
+fn accepts_unrelated_non_path_mount_root() {
+    let mounts = b"1 0 0:1 / / rw - ext4 disk rw\n\
+                   2 1 0:5 net:[4026531833] /run/docker/netns/default rw - nsfs nsfs rw\n";
+    let directory = Path::new("/tmp/codex-daemon-1000");
+    for mount_id in [Some("1"), None] {
+        assert!(check_mounts(directory, "0:1", mount_id, mounts).is_ok());
+    }
+}
+
+#[test]
+fn rejects_relevant_non_path_mount_roots() {
+    let directory = Path::new("/tmp/codex-daemon-1000");
+
+    let nested = b"1 0 0:1 / / rw - ext4 disk rw\n\
+                   2 1 0:5 net:[4026531833] /tmp/codex-daemon-1000/nested rw - nsfs nsfs rw\n";
+    for mount_id in [Some("1"), None] {
+        assert!(check_mounts(directory, "0:1", mount_id, nested).is_err());
+    }
+
+    let containing = b"1 0 0:1 / / rw - ext4 disk rw\n\
+                       2 1 0:5 net:[4026531833] /tmp rw - nsfs nsfs rw\n";
+    for mount_id in [Some("1"), None] {
+        assert!(check_mounts(directory, "0:1", mount_id, containing).is_err());
+    }
+
+    assert!(
+        check_mounts(
+            Path::new("/run/docker/netns/default"),
+            "0:5",
+            Some("2"),
+            nested
+        )
+        .is_err()
+    );
+}
